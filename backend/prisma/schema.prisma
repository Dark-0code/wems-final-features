generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./wems.db"
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  password   String
  role       String   @default("both")
  adminRole  String   @default("user")
  phone      String?
  location   String   @default("Abuja, Nigeria")
  suspended  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  listings        WasteListing[]
  sentMessages    Message[]        @relation("SentMessages")
  conversations1  Conversation[]   @relation("ConvUser1")
  conversations2  Conversation[]   @relation("ConvUser2")
}

model WasteListing {
  id           String   @id @default(cuid())
  title        String
  description  String
  category     String
  quantity     Float
  unit         String   @default("kg")
  pricePerUnit Float
  location     String
  status       String   @default("available")
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sellerId     String
  seller       User     @relation(fields: [sellerId], references: [id])
  conversations Conversation[]
}

model Conversation {
  id          String    @id @default(cuid())
  user1Id     String
  user2Id     String
  listingId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user1       User      @relation("ConvUser1", fields: [user1Id], references: [id])
  user2       User      @relation("ConvUser2", fields: [user2Id], references: [id])
  listing     WasteListing? @relation(fields: [listingId], references: [id])
  messages    Message[]

  @@unique([user1Id, user2Id, listingId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
}

model PriceGuide {
  id           String   @id @default(cuid())
  category     String   // e.g. "metal"
  material     String   // e.g. "Copper (clean wire)"
  minPrice     Float    // per kg
  maxPrice     Float    // per kg
  unit         String   @default("kg")
  grade        String?  // e.g. "Grade A", "Mixed", "Clean"
  notes        String?  // e.g. "Price varies by purity"
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}
